# Server-only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
SENTRY_DSN=
# Secret used to authenticate internal classification/ML pipeline calls
INTERNAL_CLASSIFY_SECRET=
# When set, bypasses auth checks in local dev (never set in production)
DEV_AUTH_BYPASS=

# Client-safe (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo/live deployment switch (build-time, inlined). Unset or "1" = demo build
# (synthetic corpus, mock analytics, demo personas). "0" = live build — real
# Supabase data only (civic-testing deployment).
NEXT_PUBLIC_DEMO_MODE=
# Cross-link targets for the in-app demo/testing switch button (defaults shown)
NEXT_PUBLIC_DEMO_SITE_URL=https://civic-city-demo.vercel.app
NEXT_PUBLIC_TESTING_SITE_URL=https://civic-testing.vercel.app

# Out-of-band notification delivery (status-change emails to residents).
# All optional — absent → log-only no-op (status changes still write the in-app
# notification row via the DB trigger). Set RESEND_API_KEY to actually send.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Civic <notify@yourdomain.com>
# Force log-only even when a key is present (useful for staging).
NOTIFY_DISABLE=
# Absolute site origin used to deep-link emails back to the report status page.
NEXT_PUBLIC_SITE_URL=
