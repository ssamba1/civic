# Server-only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
SENTRY_DSN=
# Secret used to authenticate internal classification/ML pipeline calls
INTERNAL_CLASSIFY_SECRET=
# HMAC key that signs the civic_demo_session cookie (demo persona sign-in).
# Server-only — MUST NOT be a NEXT_PUBLIC_* var. If unset, demo sign-in fails
# closed: the cookie won't verify, so no demo persona (incl. staff) authenticates.
# REQUIRED for any deployment that demos the personas — every reader now goes
# through findVerifiedDemoAccount, so an unset secret means no persona resolves
# anywhere (admin console and city staff surfaces alike).
# Set to any long random string.
DEMO_COOKIE_SECRET=
# When set, bypasses auth checks in local dev (never set in production)
DEV_AUTH_BYPASS=
# The single platform-set, un-spoofable request header carrying the real client
# IP (e.g. "x-real-ip" on Vercel/nginx, "cf-connecting-ip" on Cloudflare). The
# rate limiter keys off ONLY this header when set, so a client can't rotate the
# limiter key by forging x-forwarded-for. REQUIRED in production (NODE_ENV=
# production) — server env validation throws without it. Unset in local/dev.
RATE_LIMIT_TRUSTED_HEADER=
# Salt for the opaque /r/[token] public status URLs (token = sha256(salt:reportId)).
# REQUIRED in production — server env validation throws without it. Report ids
# are published through the Open311 API, so with the built-in default salt any
# third party can compute the status URL of every report in the system. Set to a
# long random string, and note that changing it invalidates every existing link.
PUBLIC_TOKEN_SALT=
# Open311 GeoReport v2 API key for external service request submissions
OPEN311_API_KEY=
# UUID of the system user that receives externally-created Open311 reports
OPEN311_SYSTEM_USER_ID=

# Client-safe (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Sentry DSN for the browser and edge runtimes. instrumentation-client.ts and
# sentry.edge.config.ts read ONLY this one; the server config falls back to it
# when SENTRY_DSN is unset. Leaving it blank disables client + edge reporting,
# which is why a deployment can have server errors in Sentry and no browser ones.
NEXT_PUBLIC_SENTRY_DSN=

# Demo/live deployment switch (build-time, inlined). Unset or "1" = demo build
# (synthetic corpus, mock analytics, demo personas). "0" = live build — real
# Supabase data only (civic-testing deployment).
NEXT_PUBLIC_DEMO_MODE=
# Cross-link targets for the in-app demo/testing switch button. Only needed if
# you run a demo build and a live build side by side and want to hop between
# them. Leave both unset for a single deployment — the button then renders
# nothing rather than linking somewhere that isn't yours.
NEXT_PUBLIC_DEMO_SITE_URL=
NEXT_PUBLIC_TESTING_SITE_URL=
# Async classification mode: set to "1" to defer AI classification result to client subscription
# (resident submits → report ID returned immediately, classification happens async).
# Unset or "0" (default) = sync mode (resident waits for classification before submit completes).
NEXT_PUBLIC_ASYNC_CLASSIFY=

# --- AI work order + dedup (server-only; default OFF to keep the demo predictable) ---
# Requires migrations 010–013 applied (npm run db:migrate) before enabling.
#
# AI_WORK_ORDER="1": generate the work order (crew/materials/minutes/cost +
# rationale) with a second Gemini call instead of the deterministic rules table.
# Rules remain the fallback if the AI call fails. A deterministic est_cost ships
# either way, so cost is present even with this OFF.
AI_WORK_ORDER=
# DEDUP_REPORTS="1": mark a new non-emergency report 'merged' when it duplicates
# an earlier open report of the same category within DEDUP_RADIUS_M metres and
# 30 days (skips the work order, records a merges row). Emergencies never deduped.
DEDUP_REPORTS=
# Geographic radius in metres for duplicate detection (default 50).
DEDUP_RADIUS_M=

# Out-of-band notification delivery (status-change emails to residents).
# All optional — absent → log-only no-op (status changes still write the in-app
# notification row via the DB trigger). Set RESEND_API_KEY to actually send.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Civic <notify@yourdomain.com>
# Force log-only even when a key is present (useful for staging).
NOTIFY_DISABLE=
# Absolute site origin used to deep-link emails back to the report status page.
NEXT_PUBLIC_SITE_URL=

# --- Video damage-mapping pipeline (server-only; ships dark like AI_WORK_ORDER) ---
# VIDEO_PIPELINE="1": master switch. Unset/0 means the ingest actions refuse,
# /city/[slug]/video 404s, and no pipeline code runs. Required by
# e2e/video-console.spec.ts — the clip-theater specs fail without it.
VIDEO_PIPELINE=
# Absolute path to the ONNX road-damage model (YOLOv8-style export, 640x640).
# Weights are NOT vendored — fetch with scripts/fetch-video-model.mjs. Unset
# makes clip processing fail with an actionable error instead of silently
# detecting nothing.
VIDEO_DETECT_MODEL_PATH=
# Comma-separated detector class names, index-aligned with the model's output
# channels. Default is the RDD2022 4-class convention:
# longitudinal_crack,transverse_crack,alligator_crack,pothole
VIDEO_DETECT_CLASSES=
# Frames sampled per second of video (0 < n <= 10, default 1). 1 fps is roughly
# one frame every 8 m at 30 km/h.
VIDEO_FRAME_FPS=
# Cluster confidence at/above which stage 2 (the Gemini decision run) fires
# (0 < n <= 1, default 0.55). Below it a cluster stays a 'candidate' for manual
# staff review instead of spending model budget on weak evidence.
VIDEO_ESCALATE_MIN_CONF=

# Cesium ion access token for the opt-in 3D globe renderer on the city map.
# Client-side by necessity (the browser fetches the tiles). Without it the globe
# still renders, as a plain ellipsoid with no terrain and no 3D buildings.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# SMS status notifications via Twilio. All three are optional and validated as
# such: with any of them unset the notifier logs the message and skips the send
# rather than throwing, so a deployment without an SMS budget still runs and
# residents simply get email-only updates.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─────────────────────────────────────────────────────────────────────────────
# The rest of the variables this codebase actually reads.
#
# Everything below was already honoured by the code and documented nowhere, so
# the only way to discover it was to grep for `process.env`. All of it is
# optional — each has a working default or a clean unconfigured path — which is
# exactly why it stayed invisible.
# ─────────────────────────────────────────────────────────────────────────────

# --- Feature flags (server-only unless prefixed) ---
# AI_CREW_ASSIGN="1": auto-assign a crew on the work order, ranked
# staffed-before-hollow then fewest open work orders then name. Deterministic —
# no extra Gemini call. Default OFF; staff can always assign via the grid.
# Skipped for needs_manual_review reports.
AI_CREW_ASSIGN=
# NEXT_PUBLIC_HELP_ASSISTANT="1": show the in-app help assistant launcher. This
# one is client-visible by necessity (the launcher renders in the browser), and
# e2e/assistant.spec.ts asserts BOTH shapes — launcher absent when off, present
# and interactive when on.
NEXT_PUBLIC_HELP_ASSISTANT=

# --- Gemini quota ceiling (server-only) ---
# Local, in-process caps checked before every Gemini call, so a runaway loop or
# a burst of submissions cannot exhaust the API quota (or the bill) in one
# minute. These are OUR limits, not Google's — set them under whatever the key's
# real quota is. Defaults: 40 / 300 / 1500. Any unparseable or non-positive
# value falls back to the default rather than disabling the limit.
GEMINI_RPM=
GEMINI_RPH=
GEMINI_RPD=

# --- Camera / video detector sidecar (server-only) ---
# Base URL of the Python detector in services/detector. Consumed by
# lib/camera/ingest.ts (POST /detect) and lib/privacy/blur-server.ts
# (POST /blur). UNSET IS SAFE AND IS THE DEFAULT: camera ingest answers
# 503 { retryable: true } and stores nothing. It never falls back to storing an
# unblurred frame — see services/detector/README.md, "Privacy posture".
DETECTOR_URL=

# --- SMS intake fallback location (server-only) ---
# An inbound SMS report carries no coordinates, so the intake route needs a city
# and a point to attach it to. These are the defaults it uses. Shipping the
# built-in values means SMS reports for YOUR deployment land in Ahilyanagar, so
# set all three if you enable Twilio inbound.
# Defaults: ahilyanagar / 19.0948 / 74.748
SMS_INTAKE_CITY_SLUG=
SMS_INTAKE_LAT=
SMS_INTAKE_LNG=

# --- Cron / timer bearer secrets (server-only) ---
# Each admin job accepts `Authorization: Bearer <secret>` INSTEAD of a staff
# session, so a systemd timer or external cron can drive it headlessly. The
# secret alone is therefore full authority over that endpoint — treat each like
# a password, not like a job name. Unset = the endpoint is staff-session-only,
# which is the safe default. Compared in constant time (lib/auth/cron-bearer.ts).
#   SLA_CRON_SECRET     POST /api/admin/sla-escalate  — rewrites work-order
#                       priority, appends to report timelines
#   NOTIFY_CRON_SECRET  POST /api/admin/notify-drain  — re-sends resident email
#   STORM_CRON_SECRET   GET|POST /api/admin/surge     — city-wide priority bump
#   DRIFT_CRON_SECRET   GET /api/admin/drift          — classification drift
SLA_CRON_SECRET=
NOTIFY_CRON_SECRET=
STORM_CRON_SECRET=
DRIFT_CRON_SECRET=

# --- Legacy-system connectors (server-only) ---
# Optional outbound sync on report status change (lib/integrations/connectors.ts,
# called from lib/notify/status-notify.ts). Each pair is independent: a
# connector with either half missing is skipped silently, so a city can enable
# one and leave the rest blank. Payload field names are best-effort per public
# docs — confirm against a vendor sandbox before go-live.
CITYWORKS_URL=
CITYWORKS_TOKEN=
ACCELA_URL=
ACCELA_TOKEN=
TYLER_URL=
TYLER_TOKEN=
SALESFORCE_URL=
SALESFORCE_TOKEN=
# Esri feature-layer applyEdits endpoint.
ARCGIS_FEATURE_URL=
ARCGIS_TOKEN=

# --- Scripts only; never read by the app ---
# Direct Postgres connection string for the one-off runners
# (scripts/run-migrations.mjs, fix-extras.mjs, setup-features.mjs). The normal
# path is `pnpm db:migrate` (supabase db push), which does not need this.
DATABASE_URL=
# Password scripts/set-passwords.mjs writes for the demo personas.
# DEMO ONLY — this script sets known credentials. Never point it at production.
# Default: CivicDemo123!
DEMO_PASSWORD=

# --- Test / CI only ---
# The RLS suites in tests/rls/ are opt-in and stay in skipIf mode without these,
# so `pnpm test` is hermetic and CI is green on a fork with no secrets. Two
# gating conventions are in play — see tests/rls/README.md for which suite needs
# which. `pnpm test:rls` sets RUN_RLS_TESTS for you.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
RUN_RLS_TESTS=
# Playwright targets. E2E_PORT keeps a local run off a dev server another
# checkout already holds on 3000 (see e2e/README.md); E2E_BASE_URL points the
# suite at an already-deployed target instead.
E2E_PORT=
E2E_BASE_URL=

# --- Deliberately not listed above ---
# Three groups are read by this repo but do not belong in a .env file:
#   NODE_ENV, CI, TEMP     set by the runtime, the CI provider or the OS.
#   CHECK_MIGRATION_*      per-assertion opt-ins inside tests/rls (012, 024,
#                          030, 031, 033, 034, 042, 025_028). They exist so an
#                          unapplied migration reads as "not checked" rather
#                          than as a regression; pass them inline on the command
#                          line, not from a file.
#   SHOT_CITY, SHOT_STATUS_TOKEN, EVAL_MOCK, PROVIDER
#                          one-shot arguments to the capture and eval scripts in
#                          scripts/ — see scripts/README.md.
# Everything else `process.env` is read for in src/, scripts/ and supabase/ is
# documented in this file. If you add a variable, add it here too; that
# invariant is the only thing that makes this file trustworthy.
