# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# CSV backups and data exports
civic_outreach*.csv
*_review*.csv

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Catch-all FIRST so no env variant can slip through. A `.env.local.bak` made
# by a hand-run `cp` was committed once because the list below enumerated exact
# names and a .bak suffix matched none of them.
.env*
!.env.example
.env
.env.local
.env.*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

.vercel

certificates

# graphify tool artifacts
graphify-out/
.graphify_python
.graphify_uncached.txt
# local QA screenshot artifacts + stray captures (kept out of the public repo)
scripts/shots/
/IMG_4622.jpg

# playwright-mcp browser session artifacts
.playwright-mcp/

# Playwright artifacts
test-results/
.mcp.json
outreach/*

# detector demo artifacts (AGPL venv + media stay local)
services/detector/.venv/
# Python bytecode. services/detector/README.md's own run instructions
# (`uvicorn app:app`) write services/detector/__pycache__/app.cpython-*.pyc on
# the first request, and git then offers it up as an untracked file to anyone
# who runs `git add -A` — a compiled copy of the service, versioned against
# whatever interpreter that machine happened to have.
__pycache__/
*.py[cod]
.pytest_cache/
services/detector/model/
services/detector/sample_video.mp4
services/detector/demo_output*.mp4
services/detector/runs/
# video pipeline model weights (fetch with scripts/fetch-video-model.mjs)
/models/

# local demo video artifact (42MB, never commit) — the small detections.json
# sidecar IS committed so the playback overlay works on deploys.
/public/demo/*.mp4

# Cesium static runtime — regenerated by scripts/copy-cesium-assets.mjs
/public/cesium/

# scratch from scripts/shot-readme-gif.mjs
docs/images/.video/

# one-off probe scripts (tok.tmp.mjs et al) — never commit these
*.tmp.mjs
*.tmp.ts
