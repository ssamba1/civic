{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_PREVIEW_MODE": "0" },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_PREVIEW_MODE": "0" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_PREVIEW_MODE": "0" }
    }
  },
  "submit": { "production": {} }
}
